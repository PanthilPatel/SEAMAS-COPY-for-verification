# Production environment configuration template.
# NOTE: In production (ENVIRONMENT=production), validate_production_config() strictly enforces:
# 1. ALLOWED_ORIGINS & FRONTEND_BASE_URL must use real HTTPS hostnames (no localhost, IP addresses, or .example domains).
# 2. RAZORPAY_KEY_ID must be a live production key starting with 'rzp_live_' (test keys 'rzp_test_' are rejected).
# 3. Secret keys must not begin with dummy prefixes ('replace', 'your-', 'placeholder').
# 4. RATE_LIMIT_KEY_SECRET must be at least 32 characters long.
# 5. UPSTASH_REDIS_REST_URL must use HTTPS.

ENVIRONMENT=production
FRONTEND_BASE_URL=https://app.seamas.ai
BACKEND_BASE_URL=https://api.seamas.ai
ALLOWED_ORIGINS=https://app.seamas.ai
SUPABASE_URL=https://production-project-ref.supabase.co
SUPABASE_ANON_KEY=production_anon_jwt_token_sample
SUPABASE_SERVICE_ROLE_KEY=production_service_role_jwt_token_sample
RAZORPAY_KEY_ID=rzp_live_production_key_id
RAZORPAY_KEY_SECRET=production_razorpay_secret_key
UPSTASH_REDIS_REST_URL=https://production-redis-cluster.upstash.io
UPSTASH_REDIS_REST_TOKEN=production_upstash_rest_token_sample
RATE_LIMIT_KEY_SECRET=production_secret_key_minimum_32_characters_long_hash
SEARXNG_BASE_URL=https://search.seamas.ai
TAVILY_API_KEY=
# Optional; omit or leave blank to use deterministic non-LLM fallbacks in production.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:7b
