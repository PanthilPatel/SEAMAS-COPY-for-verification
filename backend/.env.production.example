# Copy to the deployment secret store; replace every placeholder before startup.
ENVIRONMENT=production
FRONTEND_BASE_URL=https://app.your-company.example
BACKEND_BASE_URL=https://api.your-company.example
ALLOWED_ORIGINS=https://app.your-company.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-secret
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-rest-token
RATE_LIMIT_KEY_SECRET=replace-with-random-secret-at-least-32-characters
SEARXNG_BASE_URL=https://search.your-company.example
TAVILY_API_KEY=
# Optional; omit to use deterministic non-LLM fallbacks.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:0.5b
